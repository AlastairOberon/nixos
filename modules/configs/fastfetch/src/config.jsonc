{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/my_logo.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "cyan"
    }
  },
  "modules": [
    "break",
    "title",
    "break",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
