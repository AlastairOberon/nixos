configuration {
    modi: "drun,window,run";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "ghostty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: " Apps ";
    sidebar-mode: true;
}

@theme "/dev/null"
/* --- THE FIX: Import the dynamic Pywal colors! --- */
@import "~/.cache/wal/colors-rofi.rasi"

* {
    /* Removed the hardcoded colors from here, they are now handled by the import */
    height: 500;
    width: 800;
    font: "JetBrains Mono 14";
}

window {
    border: 1px;
    border-color: @main-col; 
    background-color: @bg-col;
    border-radius: 10px;
}

mainbox {
    background-color: @bg-col-dark;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col-dark;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @main-col;
    padding: 6px;
    text-color: @bg-col-dark;
    border-radius: 3px;
    margin: 20px 0px 0px 20px;
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
}

listview {
    border: 0px 0px 0px;
    padding: 0px 0px 0px;
    margin: 10px 0px 0px 20px;
    columns: 2;
    background-color: @bg-col-dark;
}

element normal.normal {
    padding: 15px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element alternate.normal {
    padding: 15px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element selected {
    background-color: @main-col;
    text-color: @bg-col-dark;
}

element-text {
    padding: 15px;
    background-color: transparent;
    text-color:        inherit;
}

element-icon {
    padding: 5px;
    background-color: transparent;
    text-color:        inherit;
    size: 2.5ch;
}

mode-switcher {
    spacing: 0;
    margin: 5px 10px;
    background-color: transparent;
}

button {
    padding: 10px;
    background-color: @bg-col;
    text-color: @fg-col;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: @main-col;
    text-color: @bg-col-dark;
    border-radius: 5px;
}
